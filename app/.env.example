EXPO_PUBLIC_API_URL=http://192.168.18.4/api

# Opcional — deixe vazio pra rodar sem Sentry (SDK vira no-op sem DSN).
# DSN não é secreto (é feito pra ir no bundle do cliente), mas ainda
# assim guarde no Bitwarden junto com os outros valores do projeto.
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat (L1 — monetização, 2026-08-21). Public app-specific API key
# (não é a secret key da conta — essa nunca vai aqui). Vazio = SDK não
# inicializa, app roda normal sem oferecer Pro (ver services/purchases.ts).
# Uma chave por loja: Android usa a key do Google Play (ou do Test Store,
# enquanto não existir produto real na Play Console).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
