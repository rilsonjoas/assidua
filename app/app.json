{
  "expo": {
    "name": "Assídua",
    "slug": "meus-remedios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "assidua",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.assidua.app"
    },
    "android": {
      "package": "com.assidua.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4f46e5",
          "sounds": []
        }
      ],
      "expo-asset",
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos pra você reconhecer visualmente o medicamento.",
          "cameraPermission": "O app usa a câmera pra fotografar o medicamento."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "800f08f4-a6f9-44db-b8ae-8897610bcb36"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/800f08f4-a6f9-44db-b8ae-8897610bcb36"
    }
  }
}
