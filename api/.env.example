APP_NAME="Meus Remédios"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Produção usa Resend via relay SMTP (configurado 2026-08-16, testado
# ponta a ponta — magic link chegou de verdade no Gmail). Local/dev
# continua com MAIL_MAILER=log (não manda e-mail nenhum, só grava em
# storage/logs) — não precisa de conta Resend pra rodar localmente.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Produção (não commitar a senha real aqui, só documentando o formato):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=<API key do Resend, fica só no .env real + Bitwarden>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=meusremedios@narniano.com
# MAIL_FROM_NAME="Meus Remédios"

# Opcional — vazio = Sentry desligado (código roda normal sem erro).
# Conta pessoal em sentry.io, mesmo projeto pode servir o mobile também
# (não precisa 1 conta por app).
SENTRY_LARAVEL_DSN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RevenueCat (L1 — monetização, 2026-08-21). Vazio = webhook recusa
# tudo com 401, não quebra o resto do app. Configurar em Project
# Settings → Integrations → Webhooks no dashboard do RevenueCat — cola
# a mesma string aqui e lá como "Authorization header value".
# app_user_id do evento = id numérico do usuário Laravel (ver
# services/purchases.ts do app, Purchases.logIn(String(user.id))).
REVENUECAT_WEBHOOK_SECRET=

# Web auth — origens que podem receber redirect de token no browser (vírgula)
# WEB_AUTH_ORIGINS="https://meusremedios.narniano.com"
