# Chaves OBRIGATÓRIAS no .env de produção (nomes apenas — nunca valores).
# Consumido pelo drift check do workflow Deploy VPS: se alguma destas
# faltar no /opt/meus-remedios/api/.env do VPS, o deploy BLOQUEIA.
#
# Regra para editar esta lista: uma chave entra aqui só se o app QUEBRA
# (ou feature morre) sem ela. Variáveis opcionais/com default do
# Laravel ficam fora — .env.example é template completo, não contrato.
APP_KEY
APP_ENV
APP_URL
DB_CONNECTION
DB_HOST
DB_PORT
DB_DATABASE
DB_USERNAME
DB_PASSWORD
MAIL_MAILER
MAIL_FROM_ADDRESS
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI
REVENUECAT_WEBHOOK_SECRET
SENTRY_LARAVEL_DSN
WEB_AUTH_ORIGINS
